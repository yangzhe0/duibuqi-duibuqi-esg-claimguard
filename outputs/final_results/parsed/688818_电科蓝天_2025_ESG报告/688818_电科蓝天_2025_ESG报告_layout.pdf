  <rdf:Description rdf:about=""
    xmlns:dc="http://purl.org/dc/elements/1.1/">
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A captivating neon pastel-themed scene featuring a glowing square frame. This digital artwork captures vibrant energy and modern abstract design elements, perfect for tech-inspired projects.</rdf:li>
    </rdf:Alt>
   </dc:description>
