   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Summer view of Daegwallyeong Sheep Ranch in Gangwon, South Korea, with green hills, blue sky, and open pastures. A peaceful countryside landscape ideal for nature lovers and travelers.</rdf:li>
    </rdf:Alt>
   </dc:description>
